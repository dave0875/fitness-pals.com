FROM node:24-alpine

WORKDIR /app

ARG RUNTRAINER_RELEASE_SHA=unknown
ENV NEXT_PUBLIC_RUNTRAINER_RELEASE_SHA=${RUNTRAINER_RELEASE_SHA}
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json ./
RUN npm install --omit=dev

COPY . .
RUN npm run build

EXPOSE 3000

CMD ["npm", "start"]
