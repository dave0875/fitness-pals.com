# Staged production environment template for /home/fitness-pals/fitness-pals.com-secrets
# Replace placeholder values before relying on this file as the live production env.

RUNTRAINER_POSTGRES_DB=runtrainer
RUNTRAINER_POSTGRES_USER=postgres
RUNTRAINER_POSTGRES_PASSWORD=replace-me

INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
INFLUXDB_DATABASE=GarminStats
INFLUXDB_USERNAME=replace-me
INFLUXDB_PASSWORD=replace-me

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-me
# Dedicated confidential Authentik client for Grafana SSO. Generate unique values;
# Authentik bootstrap reconciles the provider and strict callback URI.
GRAFANA_OIDC_CLIENT_ID=replace-me
GRAFANA_OIDC_CLIENT_SECRET=replace-me

RUNTRAINER_DATABASE_URL=postgresql://postgres:replace-me@postgres:5432/runtrainer
RUNTRAINER_JWT_SECRET=replace-me
RUNTRAINER_FERNET_KEY=replace-me
RUNTRAINER_GOOGLE_FALLBACK_ENABLED=false
RUNTRAINER_GOOGLE_CLIENT_ID=
RUNTRAINER_GOOGLE_CLIENT_SECRET=
RUNTRAINER_GOOGLE_REDIRECT_URI=
# Dedicated Google credentials for the Authentik upstream source. The broker
# bootstrap never inherits the rollback-only RUNTRAINER_GOOGLE_* pair.
AUTHENTIK_GOOGLE_CLIENT_ID=replace-me
AUTHENTIK_GOOGLE_CLIENT_SECRET=replace-me
# Website login: Authentik web app, brokered to Google upstream.
RUNTRAINER_WEB_OIDC_SCOPE=openid email profile
RUNTRAINER_WEB_OIDC_ISSUER=https://auth.fitness-pals.com/application/o/fitness-pals-web/
RUNTRAINER_WEB_OIDC_CLIENT_ID=replace-me
RUNTRAINER_WEB_OIDC_CLIENT_SECRET=replace-me
RUNTRAINER_WEB_OIDC_REDIRECT_URI=https://fitness-pals.com/auth/callback
# GPT login: separate Authentik client, same brokered identity system.
RUNTRAINER_OIDC_SCOPE=openid email profile
RUNTRAINER_OIDC_ISSUER=https://auth.fitness-pals.com/application/o/training-agent-gpt/
RUNTRAINER_OIDC_AUTH_URL=https://auth.fitness-pals.com/application/o/authorize/
RUNTRAINER_OIDC_TOKEN_URL=https://auth.fitness-pals.com/application/o/token/
RUNTRAINER_OIDC_JWKS_URL=http://authentik-server:9000/application/o/training-agent-gpt/jwks/
RUNTRAINER_OIDC_CLIENT_ID=replace-me
RUNTRAINER_OIDC_CLIENT_SECRET=replace-me
RUNTRAINER_INFLUX_DEFAULT_URL=http://influxdb:8086
RUNTRAINER_OPENAI_API_KEY=replace-me

AUTHENTIK_TAG=2026.2.1
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_SECRET_KEY=replace-me
AUTHENTIK_BOOTSTRAP_EMAIL=authentik-admin@fitness-pals.com
AUTHENTIK_BOOTSTRAP_PASSWORD=replace-me
AUTHENTIK_BOOTSTRAP_TOKEN=replace-me

GARMIN_MODE=scraper
GARMIN_FIT_FILE=0
SYNC_WORKER_POLL_INTERVAL_SECONDS=5

CLOUDFLARE_TUNNEL_TOKEN=replace-me
CLOUDFLARE_SMOKE_URLS=https://api.fitness-pals.com/ready,https://grafana.fitness-pals.com/api/health,https://auth.fitness-pals.com/
CLOUDFLARE_SMOKE_TIMEOUT_SECONDS=90
